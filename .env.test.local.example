# Habilitas — variables SOLO para la suite de tests e2e.
# NUNCA apuntes esto a Supabase prod. Los guardarraíles rechazarán URLs
# hospedadas en `.supabase.co` a menos que fijes E2E_ALLOW_HOSTED=1 (para
# proyectos de test hosteados; usa esa flag con cuidado).
#
# Camino recomendado: Supabase CLI local (spawns Postgres+GoTrue+PostgREST en
# Docker). Ejecuta `supabase start` en la raíz del repo con la CLI instalada
# y copia los valores impresos aquí.
#
# Copia este archivo a `.env.test.local` y llena las variables.

# URL del API (http://127.0.0.1:54321 en Supabase CLI local).
E2E_SUPABASE_URL=http://127.0.0.1:54321

# Clave anon (visible al cliente; no es un secreto en ese contexto).
E2E_SUPABASE_ANON_KEY=

# Service role (para semilla y limpieza — bypassea RLS).
E2E_SUPABASE_SERVICE_ROLE_KEY=

# URL directa de Postgres (para tests que necesitan `pg` — importación YAML).
# En Supabase CLI local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
E2E_SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Autoriza URLs hospedadas (.supabase.co). Por defecto los tests rechazan
# hosts hospedados como defensa anti-prod. Solo pon `1` si el URL apunta a
# un PROYECTO DE TEST separado del real. Recomendación: dejar sin valor.
E2E_ALLOW_HOSTED=
